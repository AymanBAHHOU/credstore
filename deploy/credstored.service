# credstore daemon (spec 8). Installed by deploy/install.sh to
# /etc/systemd/system/credstored.service.
#
# Commands approved through credstore run as the `credstore` user inside this unit, so
# they see the filesystem the way this unit does. ProtectSystem=strict makes everything
# outside ReadWritePaths read-only. /home, /mnt (WSL drives) and /srv stay writable as far
# as file permissions allow: `credstore grant DIR` gives the credstore user an ACL on a
# project folder (docs/DESIGN.md, M9). The spec's ProtectHome=yes would hide /home.
[Unit]
Description=credstore secret broker
Documentation=https://github.com/AymanBAHHOU/credstore
After=local-fs.target network.target

[Service]
Type=simple
User=credstore
Group=credstore
ExecStart=/usr/local/bin/credstored
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

# /run/credstore holds the sockets (credstore-agents / credstore-approvers; 0666 when the
# installer listed users, with the daemon checking each peer's uid); the directory
# itself is 0755 so clients can reach them.
RuntimeDirectory=credstore
RuntimeDirectoryMode=0755
StateDirectory=credstore
StateDirectoryMode=0700
LogsDirectory=credstore
LogsDirectoryMode=0700
UMask=0077

# Hardening from spec 8.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
PrivateTmp=yes
ReadWritePaths=/var/lib/credstore /var/log/credstore /run/credstore
ReadWritePaths=-/home -/mnt -/srv
# AF_NETLINK is not in the spec's list: bubblewrap needs it to bring up loopback in the
# network namespace of a run with network = "deny" (docs/DESIGN.md).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
LimitCORE=0
# Inherited by the commands credstore runs: JIT runtimes (node, java, some python
# builds) fail under it. See README before removing it.
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
