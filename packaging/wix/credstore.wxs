<?xml version="1.0" encoding="utf-8"?>
<!--
  credstore Windows installer (M8). Built by packaging/build-msi.ps1 with WiX 5.

  The MSI owns the files, the PATH entry and a Start menu shortcut. When build-msi.ps1
  finds the desktop app (M10) it is included and its shortcut is the only one: the app
  guides first-time setup itself. Without the app, the shortcut runs `credstore setup`.
  Everything else (service, groups, ACLs, policy) is done by the same install.ps1 that
  installs from source, run with -Package as a deferred custom action (as SYSTEM).

  Double-clicked, it shows a welcome page, a ready page, the progress and a finish page
  that says what to do next and offers to open the app (CredstoreUI below). Silent
  installs (/qn, as CI does) skip all of it.

  Public properties (msiexec /i credstore.msi NAME=value):
    CREDSTOREUSER    account added to the credstore groups (default: the installing user)
    ENCRYPTPAGEFILE  1 (default) turns on page file encryption; 0 leaves it alone
    DELETEDATA       1, when removing (msiexec /x credstore.msi DELETEDATA=1): also
                     delete the vault, policy, audit log and groups. Never on upgrade.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="credstore"
      Manufacturer="credstore"
      Version="$(var.Version)"
      UpgradeCode="6f3c2a4e-8d1b-4c7a-9e55-2b7d0c9a41f3"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of credstore is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="credstore.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="credstore.ico" />
    <Property Id="ARPCOMMENTS" Value="Lets coding agents use secrets without seeing them." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/AymanBAHHOU/credstore" />
    <Property Id="ENCRYPTPAGEFILE" Value="1" Secure="yes" />
    <Property Id="CREDSTOREUSER" Secure="yes" />
    <Property Id="DELETEDATA" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="credstore" />
    </StandardDirectory>

    <ComponentGroup Id="Files" Directory="INSTALLFOLDER">
      <Component>
        <File Source="$(var.BinDir)\credstore.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(var.BinDir)\credstored.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(var.BinDir)\credstore-sandbox.exe" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(var.DeployDir)\install.ps1" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(var.DeployDir)\policy.toml" KeyPath="yes" />
      </Component>
<?if $(var.WithApp) = "1" ?>
      <Component>
        <File Id="AppExeFile" Source="$(var.AppExe)" Name="credstore-app.exe" KeyPath="yes" />
      </Component>
<?endif?>
      <Component Id="PathEntry" Guid="0c1f7e52-3b9a-4d61-8f0e-7a2c5d9b13e8">
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last"
                     Action="set" System="yes" />
        <RegistryValue Root="HKLM" Key="Software\credstore" Name="PathEntry"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

<?if $(var.WithApp) != "1" ?>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="SetupShortcut" Guid="9a4e2d17-6c3b-4f08-b1d5-e8f27a03c6b9">
        <Shortcut Id="SetupShortcut" Name="credstore setup"
                  Description="Create the credstore vault and connect Claude Code"
                  Target="[System64Folder]cmd.exe"
                  Arguments="/k &quot;[INSTALLFOLDER]credstore.exe&quot; setup"
                  WorkingDirectory="INSTALLFOLDER" Icon="credstore.ico" />
        <RegistryValue Root="HKCU" Key="Software\credstore" Name="SetupShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
<?endif?>

<?if $(var.WithApp) = "1" ?>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AppShortcut" Guid="3d8b6f21-a47c-4e95-8c0a-51f9e2b7d460">
        <Shortcut Id="AppShortcut" Name="credstore"
                  Description="Approve requests and manage credstore secrets"
                  Target="[INSTALLFOLDER]credstore-app.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="credstore.ico" />
        <RegistryValue Root="HKCU" Key="Software\credstore" Name="AppShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
<?endif?>

    <Feature Id="Main">
      <ComponentGroupRef Id="Files" />
<?if $(var.WithApp) = "1" ?>
      <ComponentRef Id="AppShortcut" />
<?else?>
      <ComponentRef Id="SetupShortcut" />
<?endif?>
    </Feature>

    <!-- Installer pages: welcome, ready, progress, finish. No licence page and no
         folder choice (the scripts expect %ProgramFiles%\credstore). -->
    <UI Id="CredstoreUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="!(loc.Advanced_Font_FaceName)" Size="!(loc.Advanced_Font_Normal_Size)" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="!(loc.Advanced_Font_FaceName)" Size="!(loc.Advanced_Font_Bigger_Size)" />
      <TextStyle Id="WixUI_Font_Title" FaceName="!(loc.Advanced_Font_FaceName)" Size="!(loc.Advanced_Font_Title_Size)" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
<?if $(var.WithApp) = "1" ?>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="CsLaunchApp" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
<?endif?>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <UIRef Id="WixUI_Common" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- Shown on the finish page (also after a repair or removal, hence the wording). -->
<?if $(var.WithApp) = "1" ?>
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="The credstore service is running. The credstore app walks you through creating your vault, connecting Claude Code and, if you want, Windows Hello. No sign-out or restart is needed, except for page file encryption, which applies at the next restart." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open credstore now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- Runs from the finish page, so as the user, not elevated. -->
    <Property Id="WixShellExecTarget" Value="[#AppExeFile]" />
    <CustomAction Id="CsLaunchApp" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec"
                  Impersonate="yes" Return="ignore" />
<?else?>
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="The credstore service is running. Open &quot;credstore setup&quot; from the Start menu to create your vault and connect Claude Code." />
<?endif?>

    <!-- The installing user, unless CREDSTOREUSER was given. -->
    <SetProperty Id="CREDSTOREUSER" Value="[LogonUser]" Before="InstallInitialize"
                 Sequence="execute" Condition="NOT CREDSTOREUSER" />

    <!-- Deferred actions get their command line through a property named after them. -->
    <SetProperty Id="CsInstall" Before="CsInstall" Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]install.ps1&quot; -Package -User &quot;[CREDSTOREUSER]&quot; -EncryptPageFile &quot;[ENCRYPTPAGEFILE]&quot;" />
    <SetProperty Id="CsRollback" Before="CsRollback" Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]install.ps1&quot; -Package -Uninstall" />
    <!-- DELETEDATA=1 adds -DeleteData, but never when a newer version replaces this one. -->
    <SetProperty Id="CSDELETEARG" Value="-DeleteData" Before="InstallInitialize"
                 Sequence="execute" Condition="DELETEDATA = 1 AND NOT UPGRADINGPRODUCTCODE" />
    <SetProperty Id="CsUninstall" Before="CsUninstall" Sequence="execute"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]install.ps1&quot; -Package -Uninstall [CSDELETEARG]" />

    <!-- WixQuietExec runs without a console window and copies output to the MSI log. -->
    <CustomAction Id="CsRollback" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="CsInstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="CsUninstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="CsUninstall" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CsRollback" Before="CsInstall" Condition="NOT REMOVE" />
      <Custom Action="CsInstall" Before="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
